# Wide characters, grapheme clusters and mode 2027.
SIZE 10 3
PUSH "a\u{4e2d}b"
ROW 0 "a中b"
CURSOR 0 4
CELL 0 1 "中" w=2
CELL 0 2 "" w=tail
CELL 0 3 "b" w=1

# A wide character at the last column wraps and leaves a spacer head.
SIZE 5 3
PUSH "abcd\u{4e2d}"
ROW 0 "abcd"
CELL 0 4 "" w=head
ROW 1 "中"
WRAP 0 1
CURSOR 1 2

# Overwriting either half of a wide character clears the other half.
SIZE 10 2
PUSH "\u{4e2d}\u{6587}\e[1;2Hx"
ROW 0 " x文"
CELL 0 0 "" w=1
PUSH "\e[1;4Hy"
ROW 0 " x y"
CELL 0 2 "" w=1

# Emoji presentation sequences are wide; text presentation (VS15) is narrow.
SIZE 10 2
PUSH "\u{2764}\u{fe0f}|"
CELL 0 0 "❤\u{fe0f}" w=2
CURSOR 0 3
SIZE 10 2
PUSH "\u{2764}\u{fe0e}|"
CELL 0 0 "❤\u{fe0e}" w=1
CURSOR 0 2
SIZE 10 2
PUSH "\u{2764}|"
CELL 0 0 "❤" w=1

# A ZWJ sequence is one wide cell.
SIZE 10 2
PUSH "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}|"
CELL 0 0 "👨\u{200d}👩\u{200d}👧" w=2
CELL 0 2 "|" w=1
CURSOR 0 3

# Regional indicator pairs are one wide cell; a third starts a new cell.
SIZE 10 2
PUSH "\u{1f1fa}\u{1f1f8}\u{1f1ec}|"
CELL 0 0 "🇺🇸" w=2
CELL 0 2 "🇬" w=1
CELL 0 3 "|" w=1

# A combining mark joins the previous cell; at the start of a line it is its own cell.
SIZE 10 2
PUSH "e\u{301}x"
CELL 0 0 "e\u{301}" w=1
CELL 0 1 "x" w=1
SIZE 10 2
PUSH "\u{301}x"
CELL 0 0 "\u{301}" w=1
CELL 0 1 "x" w=1

# A cluster joins across a pending wrap.
SIZE 3 2
PUSH "abe\u{301}"
CELL 0 2 "e\u{301}" w=1
CURSOR 0 2 wrap

# Cursor movement between characters breaks the cluster.
SIZE 10 2
PUSH "e\e[C\e[D\u{301}"
CELL 0 0 "e\u{301}" w=1
CELL 0 1 "" w=1

# Mode 2027 off: legacy widths per code point; combining marks still join.
SIZE 10 2
PUSH "\e[?2027l\u{1f468}\u{200d}\u{1f469}|"
CELL 0 0 "👨\u{200d}" w=2
CELL 0 2 "👩" w=2
CELL 0 4 "|" w=1
SIZE 10 2
PUSH "\e[?2027le\u{301}x"
CELL 0 0 "e\u{301}" w=1
SIZE 10 2
PUSH "\e[?2027l\u{1f1fa}\u{1f1f8}|"
CELL 0 0 "🇺" w=1
CELL 0 1 "🇸" w=1

# A cluster keeps at most 64 code points; the rest are dropped.
SIZE 10 2
PUSH "a\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}b"
CURSOR 0 2
ROW 0 "á́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́b"

# Autowrap off: a wide character that does not fit is not printed.
SIZE 4 2
PUSH "\e[?7labc\u{4e2d}"
ROW 0 "abc"
PUSH "\e[?7h"

# Wide characters and insert mode.
SIZE 6 2
PUSH "abcd\e[1;1H\e[4h\u{4e2d}\e[4l"
ROW 0 "中abcd"
