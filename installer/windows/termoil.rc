// Windows resource for termoil.exe and termoil-gui.exe: the application icon and the version block.
//
// Compile it from each crate's build.rs with the embed-resource crate, passing the version as macros:
//   embed_resource::compile("../../installer/windows/termoil.rc", ["TERMOIL_VERSION_STR=\"0.1.1\"", "TERMOIL_VERSION_COMMA=0,1,1,0"])
// Both macros are built from CARGO_PKG_VERSION, which comes from [workspace.package].version.
// The file description differs by program, so a third macro, TERMOIL_FILE_DESCRIPTION, carries it.

#include <winver.h>

#ifndef TERMOIL_VERSION_STR
#define TERMOIL_VERSION_STR "0.0.0"
#endif
#ifndef TERMOIL_VERSION_COMMA
#define TERMOIL_VERSION_COMMA 0,0,0,0
#endif
#ifndef TERMOIL_FILE_DESCRIPTION
#define TERMOIL_FILE_DESCRIPTION "Termoil"
#endif

// Resource id 1 is the lowest id, which Explorer uses as the program icon.
1 ICON "termoil.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TERMOIL_VERSION_COMMA
PRODUCTVERSION TERMOIL_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Termoil"
            VALUE "FileDescription", TERMOIL_FILE_DESCRIPTION
            VALUE "FileVersion", TERMOIL_VERSION_STR
            VALUE "InternalName", "termoil"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
            VALUE "ProductName", "Termoil"
            VALUE "ProductVersion", TERMOIL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
