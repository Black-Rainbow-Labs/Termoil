// Windows resource for terminus.exe and terminus-gui.exe: the application icon and the version block.
//
// Compile it from each crate's build.rs with the embed-resource crate, passing the version as macros:
//   embed_resource::compile("../../installer/windows/terminus.rc", ["TERMINUS_VERSION_STR=\"0.1.1\"", "TERMINUS_VERSION_COMMA=0,1,1,0"])
// Both macros are built from CARGO_PKG_VERSION, which comes from [workspace.package].version.
// The file description differs by program, so a third macro, TERMINUS_FILE_DESCRIPTION, carries it.

#include <winver.h>

#ifndef TERMINUS_VERSION_STR
#define TERMINUS_VERSION_STR "0.0.0"
#endif
#ifndef TERMINUS_VERSION_COMMA
#define TERMINUS_VERSION_COMMA 0,0,0,0
#endif
#ifndef TERMINUS_FILE_DESCRIPTION
#define TERMINUS_FILE_DESCRIPTION "Terminus"
#endif

// Resource id 1 is the lowest id, which Explorer uses as the program icon.
1 ICON "terminus.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TERMINUS_VERSION_COMMA
PRODUCTVERSION TERMINUS_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Terminus"
            VALUE "FileDescription", TERMINUS_FILE_DESCRIPTION
            VALUE "FileVersion", TERMINUS_VERSION_STR
            VALUE "InternalName", "terminus"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
            VALUE "ProductName", "Terminus"
            VALUE "ProductVersion", TERMINUS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
