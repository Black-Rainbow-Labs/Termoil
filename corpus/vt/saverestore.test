# Save and restore: DECSC, DECRC, SCOSC, SCORC.
SIZE 10 4
PUSH "\e[2;5H\e[1;31m\e7\e[H\e[0m\e8"
CURSOR 1 4
PEN fg=p1 bold

# The charset and origin mode are saved too.
SIZE 10 4
PUSH "\e(0\e7\e(B\e8q"
ROW 0 "─"
PUSH "\e(B"
SIZE 10 4
PUSH "\e[2;3r\e[?6h\e7\e[?6l\e8\e[H"
CURSOR 1 0
MODE ?6 1

# DECRC without DECSC homes the cursor and resets the pen.
SIZE 10 4
PUSH "\e[3;3H\e[1m\e8"
CURSOR 0 0
PEN

# SCOSC and SCORC when left and right margins are off.
SIZE 10 4
PUSH "\e[3;6H\e[s\e[H\e[u"
CURSOR 2 5

# The pending wrap state is saved.
SIZE 5 2
PUSH "abcde\e7\e[H\e8X"
SCREEN
|abcde
|X
END
